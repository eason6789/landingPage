<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>管理控制台</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --primary: #e94560;
            --primary-dark: #c73e54;
            --bg: #0a0a0a;
            --surface: #141414;
            --surface-elevated: #1a1a1a;
            --border: #262626;
            --text: #ffffff;
            --text-secondary: #737373;
            --success: #00ff88;
            --warning: #ffb800;
            --error: #ff6b6b;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #0a0a0a 100%);
            min-height: 100vh;
            color: var(--text);
        }

        .login-screen {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: linear-gradient(135deg, #1a1a2e 0%, #0a0a0a 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }

        .login-box {
            background: rgba(255,255,255,0.05);
            backdrop-filter: blur(20px);
            padding: 50px;
            border-radius: 24px;
            text-align: center;
            border: 1px solid rgba(255,255,255,0.1);
        }

        .login-box h2 {
            margin-bottom: 30px;
            font-size: 28px;
        }

        .login-box input {
            width: 280px;
            padding: 16px 24px;
            border: 2px solid var(--border);
            border-radius: 12px;
            font-size: 16px;
            background: rgba(255,255,255,0.05);
            color: white;
            outline: none;
            transition: all 0.3s;
        }

        .login-box input:focus {
            border-color: var(--primary);
        }

        .login-box button {
            margin-top: 24px;
            padding: 16px 50px;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            color: white;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: 600;
        }

        .login-box button:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(233,69,96,0.3);
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 40px 24px;
            display: none;
        }

        .header {
            text-align: center;
            margin-bottom: 40px;
        }

        .header h1 {
            font-size: 42px;
            font-weight: 700;
            margin-bottom: 12px;
            background: linear-gradient(135deg, #fff 0%, var(--primary) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .header p {
            color: var(--text-secondary);
            font-size: 16px;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: rgba(255,255,255,0.05);
            backdrop-filter: blur(10px);
            padding: 28px;
            border-radius: 16px;
            text-align: center;
            border: 1px solid rgba(255,255,255,0.1);
        }

        .stat-card .number {
            font-size: 42px;
            font-weight: bold;
            color: var(--primary);
        }

        .stat-card .label {
            color: var(--text-secondary);
            margin-top: 8px;
            font-size: 14px;
        }

        .section-title {
            font-size: 20px;
            font-weight: 600;
            margin: 24px 0 16px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .agents-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
            margin-bottom: 40px;
        }

        .agent-card {
            background: rgba(255,255,255,0.05);
            border-radius: 20px;
            padding: 32px;
            border: 1px solid rgba(255,255,255,0.1);
            position: relative;
            overflow: hidden;
        }

        .agent-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--primary), var(--warning));
        }

        .agent-card.offline::before {
            background: var(--text-secondary);
        }

        .agent-name {
            font-size: 22px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .agent-role {
            color: var(--text-secondary);
            font-size: 14px;
            margin-bottom: 20px;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 500;
        }

        .online .status-badge {
            background: rgba(0,255,136,0.15);
            color: var(--success);
        }

        .offline .status-badge {
            background: rgba(255,255,255,0.1);
            color: var(--text-secondary);
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: currentColor;
        }

        .agent-details {
            margin-top: 24px;
            padding-top: 24px;
            border-top: 1px solid rgba(255,255,255,0.1);
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            margin: 12px 0;
            font-size: 14px;
        }

        .detail-row span:first-child {
            color: var(--text-secondary);
        }

        .panel {
            background: rgba(0,0,0,0.3);
            border-radius: 16px;
            padding: 24px;
            border: 1px solid rgba(255,255,255,0.1);
            margin-bottom: 24px;
        }

        .panel-actions {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 12px;
            margin-bottom: 16px;
        }

        .input {
            width: 100%;
            padding: 10px 12px;
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--text);
        }

        .btn {
            padding: 10px 14px;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: rgba(255,255,255,0.08);
            color: var(--text);
            cursor: pointer;
        }

        .btn.primary {
            border-color: var(--primary);
            color: var(--primary);
        }

        .btn.danger {
            border-color: var(--error);
            color: var(--error);
        }

        .table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        .table th, .table td {
            padding: 10px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            text-align: left;
        }

        .table th {
            color: var(--text-secondary);
            font-weight: 500;
        }

        .pill {
            padding: 4px 8px;
            border-radius: 8px;
            font-size: 12px;
            display: inline-block;
        }

        .pill.active { background: rgba(0,255,136,0.15); color: var(--success); }
        .pill.exhausted { background: rgba(255,107,107,0.15); color: var(--error); }

        .log-content {
            height: 220px;
            overflow-y: auto;
            font-family: 'Monaco', 'Consolas', monospace;
            font-size: 12px;
            background: rgba(0,0,0,0.5);
            padding: 16px;
            border-radius: 12px;
        }

        .log-entry {
            padding: 6px 0;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .hidden { display: none !important; }
    </style>
</head>
<body>
    <div class="login-screen" id="loginScreen">
        <div class="login-box">
            <h2>🔐 管理控制台</h2>
            <input type="password" id="password" placeholder="请输入访问密码" />
            <br>
            <button onclick="checkPassword()">进入</button>
            <p style="margin-top: 20px; color: rgba(255,255,255,0.5); font-size: 12px;" id="errorMsg"></p>
        </div>
    </div>

    <div class="container" id="mainContainer">
        <div class="header">
            <h1>🦞 真实数据管理控制台</h1>
            <p>来自后端 API 的真实运行数据</p>
        </div>

        <div class="stats">
            <div class="stat-card">
                <div class="number" id="totalTokens">0</div>
                <div class="label">总 Token</div>
            </div>
            <div class="stat-card">
                <div class="number" id="activeTokens">0</div>
                <div class="label">可用 Token</div>
            </div>
            <div class="stat-card">
                <div class="number" id="totalUses">0</div>
                <div class="label">累计使用次数</div>
            </div>
            <div class="stat-card">
                <div class="number" id="generatedCount">0</div>
                <div class="label">已生成图片</div>
            </div>
        </div>

        <div class="section-title">🧩 服务状态</div>
        <div class="agents-grid">
            <div class="agent-card" id="svc-api">
                <div class="agent-name">API 服务</div>
                <div class="agent-role">Flask 后端</div>
                <span class="status-badge"><span class="status-dot"></span><span class="status-text">未知</span></span>
                <div class="agent-details">
                    <div class="detail-row"><span>Uptime</span><span id="uptime">-</span></div>
                    <div class="detail-row"><span>端口</span><span>5000</span></div>
                </div>
            </div>
            <div class="agent-card" id="svc-generator">
                <div class="agent-name">生成器</div>
                <div class="agent-role">DashScope</div>
                <span class="status-badge"><span class="status-dot"></span><span class="status-text">未知</span></span>
                <div class="agent-details">
                    <div class="detail-row"><span>Key</span><span id="dashKey">-</span></div>
                    <div class="detail-row"><span>模型</span><span>wan2_6_t2i</span></div>
                </div>
            </div>
            <div class="agent-card" id="svc-cropper">
                <div class="agent-name">裁剪服务</div>
                <div class="agent-role">本地处理</div>
                <span class="status-badge"><span class="status-dot"></span><span class="status-text">未知</span></span>
                <div class="agent-details">
                    <div class="detail-row"><span>裁剪数</span><span id="cropCount">0</span></div>
                    <div class="detail-row"><span>上传数</span><span id="uploadCount">0</span></div>
                </div>
            </div>
        </div>

        <div class="section-title">🧾 Token 消耗整理</div>
        <div class="panel">
            <div class="panel-actions">
                <input class="input" id="newTokenUsage" placeholder="新Token可用次数，例如 10" />
                <button class="btn primary" onclick="createToken()">生成Token</button>
                <button class="btn danger" onclick="cleanupExhausted()">清理已耗尽</button>
            </div>
            <div class="panel-actions">
                <input class="input" id="searchToken" placeholder="搜索Token" />
                <select class="input" id="statusFilter">
                    <option value="all">全部</option>
                    <option value="active">可用</option>
                    <option value="exhausted">已耗尽</option>
                </select>
                <button class="btn" onclick="refreshTokens()">刷新列表</button>
            </div>
            <table class="table" id="tokenTable">
                <thead>
                    <tr>
                        <th>Token</th>
                        <th>使用</th>
                        <th>剩余</th>
                        <th>状态</th>
                        <th>创建时间</th>
                        <th>最后使用</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div class="section-title">📋 Token 使用日志</div>
        <div class="panel">
            <div class="panel-actions">
                <input class="input" id="usageToken" placeholder="按Token筛选使用记录" />
                <button class="btn" onclick="refreshUsage()">刷新日志</button>
                <button class="btn" onclick="clearUsageFilter()">清除筛选</button>
            </div>
            <div class="log-content" id="usageLogs"></div>
        </div>
    </div>

    <script>
        const API_BASE = '';
        let adminToken = localStorage.getItem('adminToken') || null;
        let refreshTimer = null;

        function setStatus(cardId, status) {
            const card = document.getElementById(cardId);
            if (!card) return;
            card.classList.remove('online', 'offline');
            card.classList.add(status === 'online' ? 'online' : 'offline');
            const txt = card.querySelector('.status-text');
            if (txt) txt.textContent = status === 'online' ? '在线' : '离线';
        }

        async function checkPassword() {
            const password = document.getElementById('password').value;
            try {
                const res = await fetch('/api/admin/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ password })
                });
                const data = await res.json();
                if (data.code !== 0) throw new Error(data.message || '登录失败');
                adminToken = data.data.token;
                localStorage.setItem('adminToken', adminToken);
                document.getElementById('loginScreen').style.display = 'none';
                document.getElementById('mainContainer').style.display = 'block';
                startAutoRefresh();
            } catch (err) {
                document.getElementById('errorMsg').textContent = err.message;
            }
        }

        document.getElementById('password').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') checkPassword();
        });

        async function fetchStats() {
            const res = await fetch('/api/admin/stats', {
                headers: { 'X-Admin-Token': adminToken }
            });
            const data = await res.json();
            if (data.code !== 0) throw new Error(data.message || 'stats error');
            return data.data;
        }

        function formatUptime(seconds) {
            const h = Math.floor(seconds / 3600);
            const m = Math.floor((seconds % 3600) / 60);
            return `${h}h ${m}m`;
        }

        async function refreshStats() {
            const stats = await fetchStats();
            document.getElementById('totalTokens').textContent = stats.total_tokens;
            document.getElementById('activeTokens').textContent = stats.active_tokens;
            document.getElementById('totalUses').textContent = stats.total_uses;
            document.getElementById('generatedCount').textContent = stats.generated;
            document.getElementById('cropCount').textContent = stats.crops;
            document.getElementById('uploadCount').textContent = stats.uploads;
            document.getElementById('uptime').textContent = formatUptime(stats.uptime_seconds || 0);
            document.getElementById('dashKey').textContent = stats.services.generator.status === 'online' ? '已配置' : '未配置';
            setStatus('svc-api', stats.services.api.status);
            setStatus('svc-generator', stats.services.generator.status);
            setStatus('svc-cropper', stats.services.cropper.status);
        }

        async function fetchTokens() {
            const q = document.getElementById('searchToken').value.trim();
            const status = document.getElementById('statusFilter').value;
            const res = await fetch(`/api/admin/tokens?limit=100&status=${encodeURIComponent(status)}&q=${encodeURIComponent(q)}`, {
                headers: { 'X-Admin-Token': adminToken }
            });
            const data = await res.json();
            if (data.code !== 0) throw new Error(data.message || 'tokens error');
            return data.data.items || [];
        }

        function renderTokens(items) {
            const tbody = document.querySelector('#tokenTable tbody');
            tbody.innerHTML = '';
            for (const t of items) {
                const status = t.remaining > 0 ? 'active' : 'exhausted';
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${t.token}</td>
                    <td>${t.used}/${t.max_usage}</td>
                    <td>${t.remaining}</td>
                    <td><span class="pill ${status}">${status === 'active' ? '可用' : '耗尽'}</span></td>
                    <td>${t.created_at || '-'}</td>
                    <td>${t.last_used_at || '-'}</td>
                    <td>
                        <button class="btn" onclick="copyToken('${t.token}')">复制</button>
                        <button class="btn" onclick="resetToken('${t.token}')">重置</button>
                        <button class="btn danger" onclick="deleteToken('${t.token}')">删除</button>
                    </td>
                `;
                tbody.appendChild(tr);
            }
        }

        async function refreshTokens() {
            try {
                const items = await fetchTokens();
                renderTokens(items);
            } catch (err) {
                alert('Token列表获取失败: ' + err.message);
            }
        }

        async function createToken() {
            const value = parseInt(document.getElementById('newTokenUsage').value || '10');
            const max_usage = isNaN(value) ? 10 : value;
            const res = await fetch('/api/token/generate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ max_usage })
            });
            const data = await res.json();
            if (data.code !== 0) {
                alert(data.message || '生成失败');
                return;
            }
            await refreshTokens();
            await refreshUsage();
            alert('新Token: ' + data.data.token);
        }

        async function cleanupExhausted() {
            const res = await fetch('/api/admin/tokens/cleanup', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Admin-Token': adminToken },
                body: JSON.stringify({ status: 'exhausted' })
            });
            const data = await res.json();
            if (data.code !== 0) {
                alert(data.message || '清理失败');
                return;
            }
            await refreshTokens();
            await refreshUsage();
            alert('已清理: ' + data.data.deleted);
        }

        async function resetToken(token) {
            const res = await fetch('/api/admin/token/reset', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Admin-Token': adminToken },
                body: JSON.stringify({ token })
            });
            const data = await res.json();
            if (data.code !== 0) {
                alert(data.message || '重置失败');
                return;
            }
            await refreshTokens();
            await refreshUsage();
        }

        async function deleteToken(token) {
            if (!confirm('确认删除该Token吗？')) return;
            const res = await fetch('/api/admin/token/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Admin-Token': adminToken },
                body: JSON.stringify({ token })
            });
            const data = await res.json();
            if (data.code !== 0) {
                alert(data.message || '删除失败');
                return;
            }
            await refreshTokens();
            await refreshUsage();
        }

        function copyToken(token) {
            navigator.clipboard.writeText(token).then(() => {
                alert('已复制: ' + token);
            }).catch(() => {
                alert('复制失败');
            });
        }

        async function fetchUsage() {
            const token = document.getElementById('usageToken').value.trim();
            const res = await fetch(`/api/admin/token/usage?limit=120&token=${encodeURIComponent(token)}`, {
                headers: { 'X-Admin-Token': adminToken }
            });
            const data = await res.json();
            if (data.code !== 0) throw new Error(data.message || 'usage error');
            return data.data.items || [];
        }

        async function refreshUsage() {
            try {
                const items = await fetchUsage();
                const container = document.getElementById('usageLogs');
                container.innerHTML = items.map(i => `<div class="log-entry">${i.created_at} | ${i.token} | ${i.action}</div>`).join('');
            } catch (err) {
                document.getElementById('usageLogs').innerHTML = `<div class="log-entry">日志获取失败: ${err.message}</div>`;
            }
        }

        function clearUsageFilter() {
            document.getElementById('usageToken').value = '';
            refreshUsage();
        }

        function startAutoRefresh() {
            refreshStats();
            refreshTokens();
            refreshUsage();
            if (refreshTimer) clearInterval(refreshTimer);
            refreshTimer = setInterval(() => {
                refreshStats();
            }, 10000);
        }

        if (adminToken) {
            document.getElementById('loginScreen').style.display = 'none';
            document.getElementById('mainContainer').style.display = 'block';
            startAutoRefresh();
        }
    </script>
</body>
</html>
